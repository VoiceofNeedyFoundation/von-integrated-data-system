        <mxCell id="enrolments" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;6. core.enrolments&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One participant attempt in one batch; training, completion, dropout and readiness.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;enrolment_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;participant_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;batch_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;participant + batch + attempt&lt;/b&gt; : unique&lt;/div&gt;&lt;div&gt;&lt;b&gt;candidate_enrolment_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;attempt_number&lt;/b&gt; : integer NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;registration_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;training_start_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;training_end_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;completion_status&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;completion_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;dropout_stage&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;dropout_reason_category&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;dropout_reason_detail&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;reentry_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;profile_complete&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;documents_verified&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;resume_current&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;interview_ready&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;readiness_review_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;readiness_notes&lt;/b&gt; : text NULL&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
