        <mxCell id="placement_attempts" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;12. core.placement_attempts&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One candidate-opportunity attempt from mapping through verified joining/exit.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;placement_attempt_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;enrolment_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;job_opportunity_id&lt;/b&gt; : uuid NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;enrolment + opportunity + attempt&lt;/b&gt; : unique when linked&lt;/div&gt;&lt;div&gt;&lt;b&gt;attempt_number&lt;/b&gt; : integer NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;skills_fit&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;preference_fit&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;location_fit&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;accessibility_fit&lt;/b&gt; : boolean NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;suitability_status&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;suitability_reason&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;pipeline_stage&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;referral_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;interview_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;offer_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;joining_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;actual_employer_name&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;actual_job_role&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;joining_salary&lt;/b&gt; : numeric NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;salary_period&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;offer_letter_available&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;joining_verified&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;placement_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;rejection_or_exit_reason&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;status_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;evidence_url&lt;/b&gt; : text NULL&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2200" y="1260" width="820" height="635" as="geometry" />
        </mxCell>
        <mxCell id="followups" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;13. core.followups&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One employment follow-up/checkpoint attempt after placement.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;followup_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;placement_attempt_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;placement + checkpoint + attempt&lt;/b&gt; : unique&lt;/div&gt;&lt;div&gt;&lt;b&gt;checkpoint_month&lt;/b&gt; : integer NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;attempt_number&lt;/b&gt; : integer NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;due_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;followup_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;employment_status&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;current_workplace&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;previous_workplace&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;current_job_role&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;monthly_salary&lt;/b&gt; : numeric NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;salary_period&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;reason_for_leaving&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;verification_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;evidence_url&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;notes&lt;/b&gt; : text NULL&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
