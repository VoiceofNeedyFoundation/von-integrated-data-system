        <mxCell id="assessments" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;9. core.assessments&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One enrolment, assessment point/week and domain result.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;assessment_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;enrolment_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;enrolment + type + period + domain + attempt&lt;/b&gt; : unique&lt;/div&gt;&lt;div&gt;&lt;b&gt;assessment_type&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;period_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;domain_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;domain_label&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;attempt_number&lt;/b&gt; : integer NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;assessment_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;rubric_version&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;score_value&lt;/b&gt; : numeric NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;maximum_score&lt;/b&gt; : numeric NULL &amp;gt; 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;score_percent&lt;/b&gt; : numeric generated/derived&lt;/div&gt;&lt;div&gt;&lt;b&gt;completion_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;missing_reason&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;verification_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;evidence_url&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;source_result&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
