  <diagram id="von-detailed-v4" name="2. Detailed logical model">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4300" pageHeight="4300" math="0" shadow="0">
      <root>
