        <mxCell id="sessions" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;7. core.sessions&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One planned/delivered session for one batch; normalises Session 01–45 columns.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;session_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;batch_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;batch + session_number&lt;/b&gt; : unique&lt;/div&gt;&lt;div&gt;&lt;b&gt;session_number&lt;/b&gt; : integer NOT NULL &amp;gt; 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;module_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;topic&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;planned_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;actual_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;delivery_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;status_reason&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;facilitator_details&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;div&gt;&lt;b&gt;evidence_url&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;session_notes&lt;/b&gt; : text NULL&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1890" width="820" height="375" as="geometry" />
        </mxCell>
        <mxCell id="attendance" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;8. core.attendance&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One enrolment-session result; normalises Day 01–46 marks and source rosters.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;attendance_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;enrolment_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;session_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;enrolment + session&lt;/b&gt; : unique&lt;/div&gt;&lt;div&gt;&lt;b&gt;attendance_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;attendance_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;reason&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;source_register_id&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;source_mark&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;verified&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;verification_notes&lt;/b&gt; : text NULL&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
