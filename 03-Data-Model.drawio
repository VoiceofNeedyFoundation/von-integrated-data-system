        <mxCell id="employers" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;10. core.employers&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One employer organisation and its current engagement profile.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;employer_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;employer_code&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;employer_name&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;location_address&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;contact_name&lt;/b&gt; : text NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;contact_designation&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;contact_number&lt;/b&gt; : text NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;contact_email&lt;/b&gt; : text NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;sector&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;disability_types_considered&lt;/b&gt; : text[] NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;accessibility_notes&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;existing_staff_with_disability&lt;/b&gt; : integer NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;required_staff_with_disability&lt;/b&gt; : integer NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;last_contact_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;verification_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
