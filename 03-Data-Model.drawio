        <mxCell id="job_opportunities" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;11. core.job_opportunities&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One role/vacancy at one employer; supports open-vacancy and matching questions.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;job_opportunity_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;employer_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;project_id&lt;/b&gt; : uuid NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;role_title&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;work_type&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;location&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;education_required&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;skills_required&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;div&gt;&lt;b&gt;accessibility_requirements&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;salary_amount&lt;/b&gt; : numeric NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;salary_period&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;vacancies_count&lt;/b&gt; : integer NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;open_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;close_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
