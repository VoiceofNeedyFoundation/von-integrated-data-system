        <mxCell id="detailed_title" value="Voice of Needy IDS — detailed logical data model (version 4 proposal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#1f4e78;fontColor=#ffffff;fontSize=22;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="4100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="participants" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;1. core.participants&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One canonical person; current identity, profile, contact and support details.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;participant_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;participant_code&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;first_name&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;middle_name&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;last_name&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;gender_source_recorded_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;gender_confirmed_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;gender_confirmation_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;gender_confirmed_at&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;gender_confirmation_source_record_id&lt;/b&gt; : uuid NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;date_of_birth&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;primary_mobile&lt;/b&gt; : text NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;primary_email&lt;/b&gt; : text NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;mobile_verified&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;email_verified&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;disability_type&lt;/b&gt; : text NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;disability_percent&lt;/b&gt; : numeric(5,2) NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;education_level&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;address&lt;/b&gt; : text NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;district&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;state&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;pin_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;family_income&lt;/b&gt; : numeric NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;parent_guardian&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;div&gt;&lt;b&gt;support_preferences&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;div&gt;&lt;b&gt;external_file_number&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;identity_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;record_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="820" height="675" as="geometry" />
        </mxCell>
        <mxCell id="participant_identifiers" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;2. core.participant_identifiers&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;Multiple VoN, legacy, candidate, roster and external identifiers per participant.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;participant_identifier_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;participant_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;identifier_type&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;identifier_value&lt;/b&gt; : text NOT NULL, restricted&lt;/div&gt;&lt;div&gt;&lt;b&gt;normalised_hash&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;is_primary&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;is_verified&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;verified_at&lt;/b&gt; : timestamptz NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;source_record_id&lt;/b&gt; : uuid NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;type + value/hash&lt;/b&gt; : partial uniqueness&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="880" width="820" height="315" as="geometry" />
        </mxCell>
        <mxCell id="projects" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;3. core.projects&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;Programme/donor project context used across mobilisation, delivery and outcomes.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;project_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;project_code&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;project_name&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;donor_name&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;financial_year&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;start_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;end_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;target_participants&lt;/b&gt; : integer NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;centre_codes&lt;/b&gt; : text[] NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;is_active&lt;/b&gt; : boolean NOT NULL&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="140" width="820" height="315" as="geometry" />
        </mxCell>
        <mxCell id="outreach_events" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;4. core.outreach_events&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One sourcing, mobilisation, call or eligibility event; may precede identity resolution.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;outreach_event_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;participant_id&lt;/b&gt; : uuid NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;project_id&lt;/b&gt; : uuid NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;event_type&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;event_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;source_channel&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;source_name&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;call_response&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;eligibility_status&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;outcome_status&lt;/b&gt; : text NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;outcome_reason&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;next_followup_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;owner_user_id&lt;/b&gt; : uuid NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;record_classification&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;source_attributes&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="1290" width="820" height="415" as="geometry" />
        </mxCell>
        <mxCell id="batches" value="&lt;div style='font-size:15px'&gt;&lt;b&gt;5. core.batches&lt;/b&gt;&lt;/div&gt;&lt;div style='font-size:10px;color:#444'&gt;&lt;i&gt;One training cohort with planned and actual delivery context.&lt;/i&gt;&lt;/div&gt;&lt;hr&gt;&lt;div&gt;&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;batch_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;UQ&lt;/b&gt; &lt;b&gt;batch_code&lt;/b&gt; : text NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;project_id&lt;/b&gt; : uuid NOT NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;original_batch_ids&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;div&gt;&lt;b&gt;financial_year&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;centre_code&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;centre_name&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;planned_intake&lt;/b&gt; : integer NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;planned_start_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;planned_end_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;actual_start_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;actual_end_date&lt;/b&gt; : date NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;planned_session_count&lt;/b&gt; : integer NULL &amp;gt;= 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;trainer_details&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;div&gt;&lt;b&gt;planned_topics&lt;/b&gt; : jsonb NULL, validated&lt;/div&gt;&lt;div&gt;&lt;b&gt;batch_status&lt;/b&gt; : text NOT NULL, check&lt;/div&gt;&lt;div&gt;&lt;b&gt;plan_evidence_url&lt;/b&gt; : text NULL&lt;/div&gt;&lt;div&gt;&lt;b&gt;completion_evidence_url&lt;/b&gt; : text NULL&lt;/div&gt;&lt;hr&gt;&lt;div style='font-size:9px;color:#666'&gt;Common audit: created_at, updated_at, created_by, updated_by where applicable.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
